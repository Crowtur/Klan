# Completar con los valores del entorno correspondiente; no subir secretos a Git.
# Las instalaciones existentes conservan la configuración de la Parte 10.4.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
JWT_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
UPLOADTHING_TOKEN=""
CRON_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Selector de ubicación: habilitar Maps JavaScript API y Geocoding API en Google Cloud.
# Clave pública restringida por referente HTTP; se fija al compilar el frontend.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Clave de servidor independiente, restringida a Geocoding API; nunca se envía al navegador.
GOOGLE_MAPS_SERVER_API_KEY=""
# Map ID de Google para el marcador avanzado; DEMO_MAP_ID sirve para validación local.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID="DEMO_MAP_ID"

# URL HTTPS completa opcional del callback público, por ejemplo https://tu-dominio/api/uploadthing.
UPLOADTHING_CALLBACK_URL=""
