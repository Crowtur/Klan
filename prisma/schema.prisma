generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClubRole {
  CLUB_ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlanType {
  FREE
  PAID
}

enum DurationUnit {
  MONTH
  YEAR
}

enum ApplicationStatus {
  PENDING
  DOCUMENTATION_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  globalRole   GlobalRole @default(USER)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            ClubMembership[]
  membershipApplications MembershipApplication[]
  payments               Payment[]
}

model Club {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  status      ClubStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     ClubMembership[]
  membershipPlans MembershipPlan[]
  payments        Payment[]
  settlements     ClubSettlement[]
  facilities      Facility[]
}

model ClubMembership {
  id String @id @default(uuid())

  userId String
  clubId String

  role   ClubRole         @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
}

model MembershipPlan {
  id String @id @default(uuid())

  clubId      String
  name        String
  description String?

  type PlanType @default(PAID)

  price Decimal @db.Decimal(10, 2)

  durationValue Int
  durationUnit  DurationUnit

  requiresDocumentation Boolean @default(false)

  benefits Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  documentRequirements PlanDocumentRequirement[]
  applications         MembershipApplication[]
  subscriptions        Subscription[]
  PlanBenefit          PlanBenefit[]

  @@index([clubId])
  @@index([clubId, isActive])
}

model Benefit {
  id String @id @default(uuid())

  code        String  @unique
  name        String
  description String?

  createdAt DateTime @default(now())

  plans PlanBenefit[]
}

model PlanBenefit {
  id String @id @default(uuid())

  planId    String
  benefitId String

  plan    MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  benefit Benefit        @relation(fields: [benefitId], references: [id], onDelete: Cascade)

  @@unique([planId, benefitId])
  @@index([planId])
  @@index([benefitId])
}

model PlanDocumentRequirement {
  id String @id @default(uuid())

  planId String

  name        String
  description String?

  isRequired Boolean @default(true)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  documents MembershipDocument[]

  @@index([planId])
}

model MembershipApplication {
  id String @id @default(uuid())

  userId String
  planId String

  status ApplicationStatus @default(PENDING)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  reviewedById String?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  documents MembershipDocument[]

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model MembershipDocument {
  id String @id @default(uuid())

  applicationId String
  requirementId String

  fileUrl  String
  fileName String?
  mimeType String?

  status DocumentStatus @default(PENDING)

  reviewedAt   DateTime?
  reviewedById String?

  rejectionReason String?

  uploadedAt DateTime @default(now())

  application MembershipApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement PlanDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([applicationId, requirementId])
  @@index([applicationId])
  @@index([requirementId])
  @@index([status])
}

model Subscription {
  id String @id @default(uuid())

  clubMembershipId     String
  planId               String
  stripeSubscriptionId String? @unique

  status SubscriptionStatus @default(PENDING_PAYMENT)

  startedAt DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubMembership ClubMembership @relation(fields: [clubMembershipId], references: [id], onDelete: Restrict)
  plan           MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([clubMembershipId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
}

model Payment {
  id String @id @default(uuid())

  clubId         String
  userId         String
  subscriptionId String

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("usd")

  status PaymentStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeSubscriptionId    String?
  stripeInvoiceId         String? @unique

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club         Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model ClubSettlement {
  id String @id @default(uuid())

  clubId String

  year  Int
  month Int

  grossAmount Decimal @db.Decimal(10, 2)

  stripeFee   Decimal @db.Decimal(10, 2)
  transferFee Decimal @db.Decimal(10, 2)
  platformFee Decimal @db.Decimal(10, 2)

  totalFees Decimal @db.Decimal(10, 2)
  netAmount Decimal @db.Decimal(10, 2)

  status SettlementStatus @default(PENDING)

  paidAt           DateTime?
  paymentReference String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, year, month])
  @@index([clubId])
  @@index([status])
  @@index([year, month])
}

model Facility {
  id          String         @id @default(uuid())
  clubId      String
  name        String
  description String?
  location    String?
  capacity    Int?
  status      FacilityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club      Club               @relation(fields: [clubId], references: [id], onDelete: Restrict)
  schedules FacilitySchedule[]

  @@index([clubId])
  @@index([status])
}

model FacilitySchedule {
  id          String    @id @default(uuid())
  facilityId  String
  dayOfWeek   DayOfWeek
  openingTime String
  closingTime String
  isClosed    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, dayOfWeek])
  @@index([facilityId])
}
