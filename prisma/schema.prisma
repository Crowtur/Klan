generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClubRole {
  CLUB_ADMIN
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
  FINISHED
}

enum ClubStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlanType {
  FREE
  PAID
}

enum DurationUnit {
  DAY
  MONTH
  YEAR
}

enum ApplicationStatus {
  PENDING
  DOCUMENTATION_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  FINISHED
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum SettlementStatus {
  PENDING
  PROCESSING
  PAID
  CANCELLED
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
}

enum BillingMode {
  RECURRING
  ONE_TIME
}

enum MembershipEventType {
  JOINED
  REACTIVATED
  SUSPENDED
  REMOVED
  LEFT
  FINISHED
  ROLE_CHANGED
}

enum NotificationType {
  APPLICATION_SUBMITTED
  DOCUMENTS_SUBMITTED
  DOCUMENT_APPROVED
  DOCUMENT_REJECTED
  APPLICATION_APPROVED
  APPLICATION_REJECTED
  MEMBER_LEFT
  MEMBER_REMOVED
  RESERVATION_CREATED
  RESERVATION_CANCELLED
  SETTLEMENT_UPDATED
}

enum PaymentObligationStatus {
  OPEN
  PAID
  VOID
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model User {
  id           String     @id @default(uuid())
  firstName    String
  lastName     String
  email        String     @unique
  passwordHash String
  globalRole   GlobalRole @default(USER)
  status       UserStatus @default(ACTIVE)

  // Fotografía de perfil
  avatarUrl     String?
  avatarFileKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships            ClubMembership[]
  membershipApplications MembershipApplication[]
  payments               Payment[]
  posts                  Post[]
  notifications          Notification[]
  paymentObligations     PaymentObligation[]
}

model Club {
  bankDetails ClubBankDetails?
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  status      ClubStatus @default(ACTIVE)

  // Zona IANA: las fechas de informes y horarios usan esta zona.
  timeZone      String  @default("America/Guayaquil")
  address       String?
  googleMapsUrl String?
  coverUrl      String?
  coverFileKey  String?

  // Logotipo del club
  logoUrl     String?
  logoFileKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        ClubMembership[]
  membershipPlans    MembershipPlan[]
  payments           Payment[]
  settlements        ClubSettlement[]
  facilities         Facility[]
  posts              Post[]
  notifications      Notification[]
  paymentObligations PaymentObligation[]
}

model ClubMembership {
  id String @id @default(uuid())

  userId String
  clubId String

  role   ClubRole         @default(MEMBER)
  status MembershipStatus @default(ACTIVE)

  joinedAt   DateTime          @default(now())
  // No sustituye a removedAt. Solo vencimiento natural sin otro acceso.
  finishedAt DateTime?
  events     MembershipEvent[]

  removedAt     DateTime?
  removedById   String?
  removalReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  subscriptions Subscription[]
  reservations  Reservation[]

  @@unique([userId, clubId])
  @@index([userId])
  @@index([clubId])
  @@index([clubId, status])
}

model MembershipPlan {
  id String @id @default(uuid())

  clubId      String
  name        String
  description String?

  type        PlanType    @default(PAID)
  billingMode BillingMode @default(RECURRING)

  price Decimal @db.Decimal(10, 2)

  durationValue Int
  durationUnit  DurationUnit

  requiresDocumentation Boolean @default(false)

  benefits Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  documentRequirements PlanDocumentRequirement[]
  applications         MembershipApplication[]
  subscriptions        Subscription[]
  facilityAccesses     FacilityPlanAccess[]

  @@index([clubId])
  @@index([clubId, isActive])
}

model PlanDocumentRequirement {
  id String @id @default(uuid())

  planId String

  name        String
  description String?

  isRequired Boolean @default(true)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  documents MembershipDocument[]

  @@index([planId])
}

model MembershipApplication {
  id String @id @default(uuid())

  userId String
  planId String

  status ApplicationStatus @default(PENDING)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  reviewedById String?

  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  documents MembershipDocument[]

  @@index([userId])
  @@index([planId])
  @@index([status])
}

model MembershipDocument {
  id String @id @default(uuid())

  applicationId String
  requirementId String

  fileUrl       String
  fileKey       String?
  fileName      String?
  mimeType      String?
  fileSizeBytes Int?
  // La fila conserva el documento actual; las versiones previas se archivan.
  version       Int                         @default(1)
  deletedAt     DateTime?
  versions      MembershipDocumentVersion[]

  status DocumentStatus @default(PENDING)

  reviewedAt   DateTime?
  reviewedById String?

  rejectionReason String?

  uploadedAt DateTime @default(now())

  application MembershipApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirement PlanDocumentRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([applicationId, requirementId])
  @@index([applicationId])
  @@index([requirementId])
  @@index([status])
}

model Subscription {
  id String @id @default(uuid())

  clubMembershipId     String
  planId               String
  stripeSubscriptionId String? @unique

  status                SubscriptionStatus  @default(PENDING_PAYMENT)
  // Se copia al contratar; no debe cambiar al editar el plan.
  billingMode           BillingMode         @default(RECURRING)
  planNameSnapshot      String?
  priceSnapshot         Decimal?            @db.Decimal(10, 2)
  currencySnapshot      String?
  durationValueSnapshot Int?
  durationUnitSnapshot  DurationUnit?
  // Primera activación real, no fecha del último ciclo.
  suspendedAt           DateTime?
  firstActivatedAt      DateTime?
  finishedAt            DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?
  nextBillingAt         DateTime?
  cancelAtPeriodEnd     Boolean             @default(false)
  obligations           PaymentObligation[]

  startedAt         DateTime?
  expiresAt         DateTime?
  gracePeriodEndsAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubMembership ClubMembership @relation(fields: [clubMembershipId], references: [id], onDelete: Restrict)
  plan           MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([clubMembershipId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
  @@index([planId, firstActivatedAt])
  @@index([status, billingMode, expiresAt])
}

model Payment {
  id String @id @default(uuid())

  clubId         String
  userId         String
  subscriptionId String

  // Cada Payment sigue siendo un intento; varios pueden pagar una obligación.
  obligationId String?
  obligation   PaymentObligation? @relation(fields: [obligationId], references: [id], onDelete: Restrict)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("usd")

  status PaymentStatus @default(PENDING)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeSubscriptionId    String?
  stripeInvoiceId         String? @unique

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club         Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([clubId])
  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
  @@index([obligationId])
  @@index([clubId, status, paidAt])
  @@index([userId, status, paidAt])
}

model ClubSettlement {
  id String @id @default(uuid())

  clubId String

  year  Int
  month Int

  grossAmount Decimal @db.Decimal(10, 2)

  stripeFee   Decimal @db.Decimal(10, 2)
  transferFee Decimal @db.Decimal(10, 2)
  platformFee Decimal @db.Decimal(10, 2)

  totalFees Decimal @db.Decimal(10, 2)
  netAmount Decimal @db.Decimal(10, 2)

  status SettlementStatus @default(PENDING)

  paidAt           DateTime?
  paymentReference String?
  receiptUrl       String?
  receiptFileKey   String?
  receiptFileName  String?
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@unique([clubId, year, month])
  @@index([clubId])
  @@index([status])
  @@index([year, month])
}

model Facility {
  icon String @default("building")
  id          String         @id @default(uuid())
  clubId      String
  name        String
  description String?
  location    String?
  capacity    Int?
  status      FacilityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club         Club                 @relation(fields: [clubId], references: [id], onDelete: Restrict)
  schedules    FacilitySchedule[]
  planAccesses FacilityPlanAccess[]
  reservations Reservation[]

  @@index([clubId])
  @@index([status])
}

model FacilitySchedule {
  id            String    @id @default(uuid())
  facilityId    String
  dayOfWeek     DayOfWeek
  openingTime   String
  closingTime   String
  intervalOrder Int
  isClosed      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, dayOfWeek, intervalOrder])
  @@index([facilityId])
  @@index([facilityId, dayOfWeek])
}

model FacilityPlanAccess {
  id                          String @id @default(uuid())
  facilityId                  String
  membershipPlanId            String
  maxReservationMinutesPerDay Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)

  @@unique([facilityId, membershipPlanId])
  @@index([facilityId])
  @@index([membershipPlanId])
}

model Reservation {
  id String @id @default(uuid())

  facilityId       String
  clubMembershipId String

  startAt DateTime
  endAt   DateTime

  status             ReservationStatus @default(CONFIRMED)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facility       Facility       @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  clubMembership ClubMembership @relation(fields: [clubMembershipId], references: [id], onDelete: Restrict)

  @@index([facilityId, startAt, endAt])
  @@index([clubMembershipId, startAt])
  @@index([status])
}

model Post {
  id String @id @default(uuid())

  clubId   String
  authorId String

  title   String?
  content String

  imageUrl     String?
  imageFileKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club   Club @relation(fields: [clubId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([clubId, createdAt])
  @@index([authorId])
}

// Historial desde la implementación; no reconstruir bajas o altas desconocidas.
model MembershipEvent {
  id               String              @id @default(uuid())
  clubMembershipId String
  type             MembershipEventType
  previousStatus   MembershipStatus?
  newStatus        MembershipStatus
  previousRole     ClubRole?
  newRole          ClubRole
  actorId          String?
  reason           String?
  occurredAt       DateTime            @default(now())
  // Clave por operación; los reintentos reutilizan la misma.
  eventKey         String              @unique
  clubMembership   ClubMembership      @relation(fields: [clubMembershipId], references: [id], onDelete: Restrict)

  @@index([clubMembershipId, occurredAt])
  @@index([type, occurredAt])
}

// Archivo inmutable: al reemplazar/eliminar, copiar aquí la versión actual
// y luego incrementar version/resetear revisión en una sola transacción.
model MembershipDocumentVersion {
  id              String             @id @default(uuid())
  documentId      String
  version         Int
  fileUrl         String
  fileKey         String?
  fileName        String?
  mimeType        String?
  fileSizeBytes   Int?
  status          DocumentStatus
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  uploadedAt      DateTime
  archivedAt      DateTime           @default(now())
  document        MembershipDocument @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([documentId, version])
}

// Una deuda, varios intentos. Nunca sumar Payment fallidos como deudas.
model PaymentObligation {
  id              String                  @id @default(uuid())
  clubId          String
  userId          String
  subscriptionId  String
  obligationKey   String                  @unique
  stripeInvoiceId String?                 @unique
  amount          Decimal                 @db.Decimal(10, 2)
  currency        String                  @default("usd")
  status          PaymentObligationStatus @default(OPEN)
  dueAt           DateTime?
  periodStartAt   DateTime?
  periodEndAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  club            Club                    @relation(fields: [clubId], references: [id], onDelete: Restrict)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription    Subscription            @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments        Payment[]

  @@index([userId, status, dueAt])
  @@index([clubId, status, dueAt])
  @@index([subscriptionId])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  clubId      String?
  type        NotificationType
  eventKey    String
  title       String
  message     String?
  // Destino interno, validado en servidor. Nunca una URL externa arbitraria.
  targetPath  String
  entityType  String
  entityId    String
  readAt      DateTime?
  resolvedAt  DateTime?
  createdAt   DateTime         @default(now())
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  club        Club?            @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([recipientId, eventKey])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, clubId, resolvedAt])
  @@index([entityType, entityId])
}

// Recibir un webhook no equivale a procesarlo. Los efectos y PROCESSED
// deben confirmarse en una misma transacción, con bloqueo/claim del evento.
model StripeWebhookEvent {
  id              String             @id // ID de evento Stripe (evt_...), clave de idempotencia.
  type            String
  stripeCreatedAt DateTime
  status          WebhookEventStatus @default(RECEIVED)
  attempts        Int                @default(0)
  lastError       String?
  receivedAt      DateTime           @default(now())
  processedAt     DateTime?
  updatedAt       DateTime           @updatedAt

  @@index([status, receivedAt])
}

// Durable retries when storage is temporarily unavailable after a withdrawal.
model PendingFileDeletion {
  fileKey String @id
  queuedAt DateTime @default(now())
  @@index([queuedAt])
}

model ClubBankDetails {
  clubId String @id
  beneficiary String
  identity String
  bankName String
  accountType String
  accountNumber String
  club Club @relation(fields:[clubId],references:[id],onDelete:Cascade)
}

model AvatarThumbnail {
  key String @id
  small Bytes
  large Bytes
}
